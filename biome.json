{
	"$schema": "https://biomejs.dev/schemas/2.4.11/schema.json",
	"files": {
		"ignoreUnknown": false,
		"includes": ["**", "!src/**/*.svg"]
	},
	"formatter": {
		"enabled": true,
		"lineWidth": 100,
		"indentWidth": 2
	},
	"linter": {
		"rules": {
			"correctness": {
				"noUnusedImports": {
					"level": "error",
					"fix": "safe"
				}
			},
			"performance": {
				"noDelete": "off"
			},
			"style": {
				"noNonNullAssertion": "off"
			}
		}
	},
	"assist": {
		"enabled": false
	}
}
